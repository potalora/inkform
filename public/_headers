# The builder replaces the import-map token with the hash of public/studio.html.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' {{IMPORT_MAP_HASH}}; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
