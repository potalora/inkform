{
  "name": "inkform",
  "version": "1.0.0",
  "description": "Inkform browser-based tattoo placement studio",
  "scripts": {
    "build:wasm": "asc studio/wasm/morph.ts --outFile studio/wasm/morph.wasm --runtime stub --exportRuntime --exportStart _start --optimize --noAssert",
    "build:renderer": "node scripts/vendor-three.mjs && node scripts/build-pathtracer.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:public",
    "build:public": "npm run build:wasm && npm run build:renderer && npm run build:ui && node scripts/build-public.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "wrangler pages dev dist-public --ip 127.0.0.1 --port 8788",
    "preview": "npm start"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "assemblyscript": "0.28.20",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "oidn-web": "0.5.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.149.0"
  },
  "private": true,
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
